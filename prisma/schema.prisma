generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Gender {
  Male
  Female
}

enum MeetingPreference {
  Online
  Hybrid
  InPerson
}

enum GenderFocus {
  Male
  Female
  Mixed
}

enum MeetingFormat {
  Online
  Hybrid
  InPerson
}

enum VolunteerStatus {
  Pending
  Confirmed
  Rejected
}

enum EventType {
  OneTime
  MultiDay
  Recurring
}

enum RecurrenceFrequency {
  Weekly
  Biweekly
  Monthly
}

// What shape of day an EventCluster stands for (CCF-148).
//
// `Parallel` is every cluster that existed before this enum: several events
// sharing a day, which the registrant picks between on the shared form, each
// keeping its own volunteers and its own breakout tables.
//
// `Collab` is one event co-run by two ministries. The shared form asks nothing
// about events and registers the person to all of them; the member events'
// volunteer rosters read as one pool; and the day's breakout tables belong to
// the CLUSTER rather than to either event, so a collab's seating never rewrites
// a ministry's standing groups.
enum ClusterKind {
  Parallel
  Collab
}

enum MatchingContext {
  SmallGroup
  Breakout
}

enum EventModuleType {
  Baptism
  Embarkation
  CatchMech
  // Volunteers and Breakout were unconditionally available before CCF-131/CCF-128
  // made them opt-in. Existing events are backfilled to enabled; new events start
  // off, like every other module.
  Volunteers
  Breakout
  // Priced is the single gate for payment tracking — it drives both the public
  // form's payment step and the admin-side Paid / Payment Reference columns.
  Priced
}

enum DietaryPreference {
  Vegetarian
  Vegan
  Halal
  Kosher
  GlutenFree
  DairyFree
  NutFree
  Pescatarian
  Other
}

enum MemberGroupStatus {
  Member
  Timothy
  Leader
}

enum FamilyRole {
  FatherHusband
  MotherWife
  Child
  Guardian
  Other
}

enum BusDirection {
  ToVenue
  FromVenue
  Both
}

enum MemberRequestStatus {
  Pending
  Confirmed
  Rejected
}

// How a SmallGroupMemberRequest came to exist (CCF-101). See the `origin` field.
enum SmallGroupRequestOrigin {
  Assignment
  RegistrationIntent
}

enum DeclineReason {
  NotInterested
  Unresponsive
  EndorsedToAnotherLeader
  AlreadyInSmallGroup
  Others
}

enum SmallGroupLogAction {
  GroupCreated
  MemberAdded
  MemberRemoved
  MemberTransferred
  TempAssignmentCreated
  TempAssignmentConfirmed
  TempAssignmentRejected
  // Who leads the group changed. The subject (`memberId`) is the incoming leader;
  // the outgoing one is named in `description`, which is all that survives if that
  // member is later deleted.
  LeaderChanged
  // A member's standing within the group moved between Member / Timothy / Leader.
  MemberStatusChanged
}

enum SmallGroupStatus {
  Active
  Pending
  Inactive
}

enum SmallGroupType {
  Regular
  Couples
}

enum ConfirmationSubmissionSource {
  CatchMech
  CatchMechVolunteer
  SmallGroupLeader
}

enum UserRole {
  SuperAdmin
  Staff
}

enum FeatureArea {
  Members
  Guests
  SmallGroups
  Ministries
  Events
  Volunteers
  Forms
}

enum FormKey {
  JoinSmallGroup
  MemberSelfService
  SmallGroupConfirmation
  EventRegistration
  EventCheckIn
  EventWalkIn
  VolunteerSignUp
  VolunteerInfo
  VolunteerApproval
  CatchMech
}

/// The three independent surfaces a person can fill in for an event. Each one
/// configures its own sections and fields (see EventFormConfig).
enum FormContext {
  Register
  WalkIn
  CheckIn
}

// How an event's walk-in form decides which session it registers people into.
// `Pinned` reads `Event.walkInOccurrenceId` — one session an admin named.
// `Latest` follows the event's most recently created session instead, so a
// Recurring event whose sessions appear one at a time never has to be re-pointed.
enum WalkInSessionMode {
  Pinned
  Latest
}

enum PermissionAction {
  Read
  Write
  Import
  Export
}

// ─── Auth (NextAuth / Auth.js v5) ────────────────────────────────────────────

model User {
  id                String           @id @default(cuid())
  name              String?
  username          String           @unique
  email             String?          @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  tempPassword      String?
  role              UserRole         @default(Staff)
  mustChangePassword Boolean         @default(false)
  requiresTotpSetup Boolean          @default(false)
  totpSecret        String?
  totpEnabled       Boolean          @default(false)
  accounts          Account[]
  sessions          Session[]
  permissions       UserPermission[]
  eventAccess       UserEventAccess[]
  groupRequests     SmallGroupMemberRequest[]
  smallGroupLogs    SmallGroupLog[]
  catchMechComments CatchMechComment[]
  tablePreferences  UserTablePreference[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum TableDensity {
  Compact
  Comfortable
}

/// One admin's saved layout for one *kind* of table.
///
/// `tableKey` names the screen, never the record ("event.registrants", not
/// "event.<id>.registrants") — someone who has arranged the registrant columns
/// to their liking wants that arrangement on the next event too.
///
/// `hidden` and `shown` are deliberately separate rather than one `visible`
/// list: anything absent from `hidden` is on, so a column added later appears
/// for everyone, while anything absent from `shown` is off, so an opt-in column
/// added later stays out of the way. See lib/tables/preferences.ts.
model UserTablePreference {
  id        String       @id @default(cuid())
  userId    String
  tableKey  String
  hidden    String[]
  shown     String[]
  order     String[]
  density   TableDensity @default(Comfortable)
  pageSize  Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
}

model UserPermission {
  id      String           @id @default(cuid())
  userId  String
  feature FeatureArea
  action  PermissionAction @default(Read)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, action])
}

model UserEventAccess {
  userId  String
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── App Models ──────────────────────────────────────────────────────────────

/// Admin-configurable Age Range buckets — a global taxonomy managed in Settings,
/// same as LifeStage. Offered as a coarser alternative to Birth Month+Year on
/// registration forms; Birth Year stays the matching engine's source of truth and
/// a bucket is only used as a fallback when birth year is absent.
///
/// `minAge`/`maxAge` are inclusive. A null `minAge` means "and under"; a null
/// `maxAge` means "and over" — so the first and last buckets stay open-ended.
model AgeRangeBucket {
  id        String   @id @default(cuid())
  label     String   @unique
  minAge    Int?
  maxAge    Int?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]
  guests  Guest[]
}

model LifeStage {
  id          String     @id @default(cuid())
  name        String     @unique
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members        Member[]
  guests         Guest[]
  ministries     Ministry[]
  smallGroups    SmallGroup[]    @relation("SmallGroupLifeStages")
  breakoutGroups BreakoutGroup[] @relation("BreakoutGroupLifeStages")
}

model Member {
  id                  String              @id @default(cuid())
  firstName           String
  lastName            String
  nickname            String?
  email               String?             @unique
  phone               String?
  address             String?
  dateJoined          DateTime
  notes               String?

  lifeStageId         String?
  lifeStage           LifeStage?          @relation(fields: [lifeStageId], references: [id])
  // Coarse alternative to birthYear when a form collects only an age bracket.
  ageRangeBucketId    String?
  ageRangeBucket      AgeRangeBucket?     @relation(fields: [ageRangeBucketId], references: [id])

  smallGroupId        String?
  smallGroup          SmallGroup?         @relation("SmallGroupMembers", fields: [smallGroupId], references: [id])
  groupStatus         MemberGroupStatus?  // null when not in a group; set when member joins
  // "My DGroup leader is at another CCF satellite" — the member-level twin of
  // Guest.claimedSatellite, holding a name from lib/constants/ccf-satellites.ts.
  // Mutually exclusive with smallGroupId (a leader is either here or elsewhere),
  // and mirrored onto SmallGroup.parentSatellite for every group they lead. It
  // lives here as well as on the group because the answer is asked before the
  // first group exists — a member who leads nothing has nowhere else to put it.
  upwardSatellite     String?

  // Matching fields
  gender              Gender?
  language            String[]
  birthMonth          Int?
  birthYear           Int?
  workCity            String?
  workIndustry        String?
  meetingPreference   MeetingPreference?

  // Self-service token for the public /me member portal link
  selfServiceToken    String?             @unique
  selfServiceTokenAliases String[] @default([])

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  ledGroups           SmallGroup[]        @relation("SmallGroupLeader")
  schedulePreferences SchedulePreference[]
  volunteers          Volunteer[]
  eventRegistrations  EventRegistrant[]
  guest               Guest?              // set if this Member was promoted from a Guest
  groupRequests       SmallGroupMemberRequest[]
  smallGroupLogs      SmallGroupLog[]      @relation("SmallGroupLogSubject")
  performedGroupLogs  SmallGroupLog[]      @relation("SmallGroupLogActor")
  logs                MemberLog[]
  familyMemberships   FamilyMember[]
  confirmationSubmissions ConfirmationSubmission[] @relation("ConfirmationSubmissionSubmitter")
}

model Guest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  nickname    String?
  email       String?
  phone       String?
  notes       String?

  // Matching fields (same set as Member — used for SmallGroup placement)
  lifeStageId      String?
  lifeStage        LifeStage?        @relation(fields: [lifeStageId], references: [id])
  // Coarse alternative to birthYear when a form collects only an age bracket.
  ageRangeBucketId String?
  ageRangeBucket   AgeRangeBucket?   @relation(fields: [ageRangeBucketId], references: [id])
  gender           Gender?
  language         String[]
  birthMonth       Int?
  birthYear        Int?
  workCity         String?
  workIndustry     String?
  meetingPreference MeetingPreference?

  // Single schedule preference (one time slot per guest — mirrors SmallGroup pattern)
  scheduleDayOfWeek Int?     // 0 = Sunday … 6 = Saturday
  scheduleTimeStart String?  // HH:MM
  scheduleTimeEnd   String?  // HH:MM

  // Self-reported small group from check-in prompt
  claimedSmallGroupId String?
  claimedSmallGroup   SmallGroup? @relation("GuestClaimedGroup", fields: [claimedSmallGroupId], references: [id])
  // Set instead of claimedSmallGroupId when the self-reported DGroup meets at
  // another CCF satellite, so there is no local group to point at. Holds a
  // satellite name from lib/constants/ccf-satellites.ts; the two are mutually
  // exclusive (app-enforced).
  claimedSatellite    String?

  // Self-service token for the public /me portal, mirroring Member.selfServiceToken.
  // A guest gets one so the "who is your leader?" step has a refresh-safe URL; once
  // they answer they are promoted and the portal hands them their member token.
  selfServiceToken String? @unique
  selfServiceTokenAliases String[] @default([])

  // Promotion — set when Guest is added to a Small Group and becomes a Member
  memberId    String?  @unique
  member      Member?  @relation(fields: [memberId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventRegistrations EventRegistrant[]
  groupRequests      SmallGroupMemberRequest[]
  smallGroupLogs     SmallGroupLog[]
  familyMemberships  FamilyMember[]
}

// ─── Families ─────────────────────────────────────────────────────────────────
// A Family is a household unit. A person can belong to multiple families
// (e.g. an adult is a Child in their parents' family and a Father in their own),
// hence the join model rather than a familyId column on Member.

model Family {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members FamilyMember[]
}

model FamilyMember {
  id       String     @id @default(cuid())
  familyId String
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Exactly one of memberId / guestId is set (app-layer enforced, same idiom
  // as SmallGroupMemberRequest). Repointed guestId → memberId on promotion.
  memberId String?
  member   Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guestId  String?
  guest    Guest?     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  role      FamilyRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([familyId, memberId])
  @@unique([familyId, guestId])
  @@index([memberId])
  @@index([guestId])
}

model SchedulePreference {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 6 = Saturday
  timeStart String   // HH:MM
  timeEnd   String?  // HH:MM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmallGroup {
  id            String         @id @default(cuid())
  name          String
  // Required, and Restrict on delete: a DGroup without a leader is not a state the
  // app has any screen for. This was briefly optional with ON DELETE SET NULL —
  // swept in as collateral by 20260606145226, whose subject was occurrence series —
  // which let deleting a member silently orphan every group they led.
  leaderId      String
  leader        Member         @relation("SmallGroupLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  parentGroupId String?
  parentGroup   SmallGroup?    @relation("SmallGroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups   SmallGroup[]   @relation("SmallGroupHierarchy")
  // Upward accountability when the leader reports to someone outside CCF Eastwood.
  // Holds a satellite name from lib/constants/ccf-satellites.ts and is mutually
  // exclusive with parentGroupId — the parent is either a DGroup here or a satellite.
  parentSatellite String?

  // Matching fields
  lifeStages    LifeStage[]    @relation("SmallGroupLifeStages")
  genderFocus   GenderFocus?
  language      String[]
  ageRangeMin   Int?
  ageRangeMax   Int?
  meetingFormat MeetingFormat?
  locationCity  String?
  memberLimit   Int?

  // Single meeting schedule (one time slot per group)
  scheduleDayOfWeek Int?     // 0 = Sunday … 6 = Saturday
  scheduleTimeStart String?  // HH:MM
  scheduleTimeEnd   String?  // HH:MM

  // Leader confirmation token for the public confirmation link
  leaderConfirmationToken String?  @unique

  status           SmallGroupStatus     @default(Active)
  // Couples groups roster married pairs (derived from Family data); membership
  // is still individual and one-group-per-member applies unchanged.
  groupType        SmallGroupType       @default(Regular)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  members          Member[]             @relation("SmallGroupMembers")
  claimants        Guest[]              @relation("GuestClaimedGroup")
  memberRequests   SmallGroupMemberRequest[]
  incomingTransfers SmallGroupMemberRequest[] @relation("TransferFrom")
  logs             SmallGroupLog[]
  linkedBreakoutGroups BreakoutGroup[]  @relation("BreakoutLinkedGroup")
  confirmationSubmissions ConfirmationSubmission[] @relation("ConfirmationSubmissionGroup")
}

model Ministry {
  id                  String     @id @default(cuid())
  name                String     @unique
  lifeStageId         String?
  lifeStage           LifeStage? @relation(fields: [lifeStageId], references: [id])
  description         String?
  // Branding
  logoUrl             String?
  themeColorPrimary   String?
  themeColorSecondary String?
  themeColorAccent    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  events EventMinistry[]
}

model Event {
  id                    String              @id @default(cuid())
  name                  String
  description           String?
  type                  EventType           @default(OneTime)
  // Church-wide event. Distinct from having no EventMinistry rows: blank means
  // "ministry-agnostic", this means "every ministry, including ones created later".
  allMinistries         Boolean             @default(false)
  startDate             DateTime
  endDate               DateTime
  price                 Int?                // in cents; null = free
  registrationStart     DateTime?
  registrationEnd       DateTime?
  // Recurring-only fields
  recurrenceDayOfWeek   Int?                // 0 = Sunday … 6 = Saturday
  recurrenceFrequency   RecurrenceFrequency?
  recurrenceEndDate     DateTime?           // null = runs indefinitely
  // Branding
  useMinistryBrand      Boolean             @default(false)
  brandMinistryId       String?
  logoUrl               String?
  themeColorPrimary     String?
  themeColorSecondary   String?
  themeColorAccent      String?
  // Registration form modules — toggle which optional sections appear on the public form
  formIncludeSmallGroup       Boolean             @default(false)
  formIncludeDietary          Boolean             @default(false)
  formIncludePayment          Boolean             @default(false)
  autoAssignBreakout          Boolean             @default(false)
  // Registration page customization
  registrationPageTitle       String?
  registrationPageDescription String?
  registrationPageBannerUrl   String?
  // Setup walkthrough — once the admin dismisses the dashboard setup checklist it stays hidden
  setupDismissedAt            DateTime?
  // Individual walkthrough steps the admin chose to skip (SetupStepKey values).
  // A skipped step stops counting as outstanding work without pretending it was
  // done, and can be un-skipped. `@default([])` is load-bearing: without it the
  // PrismaPg adapter sends NULL for every `event.create` that omits the field.
  setupSkippedSteps           String[]            @default([])
  // Which session the walk-in form registers people into (CCF-133). Chosen by the
  // admin on the Walk-in form config rather than derived from the URL or resolved
  // at request time, so the door can never silently target a different session
  // than the one staff think they're running. Null — or a session that is closed —
  // turns the walk-in form off. OneTime events never set it: they have no
  // occurrences, and a walk-in there stamps `attendedAt` instead.
  walkInOccurrenceId          String?
  walkInOccurrence            EventOccurrence? @relation("EventWalkInSession", fields: [walkInOccurrenceId], references: [id], onDelete: SetNull)
  // Whether that pin is read at all. `Latest` ignores it and resolves the door to
  // the event's most recently created session at request time — the one case where
  // "resolved, not named" is what the admin asked for, because a Recurring event
  // grows a session every time check-in is opened and re-picking it weekly is the
  // step that gets forgotten. The isOpen gate still applies either way.
  walkInSessionMode           WalkInSessionMode @default(Pinned)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  ministries     EventMinistry[]
  registrants    EventRegistrant[]
  occurrences    EventOccurrence[]
  occurrenceSeries EventOccurrenceSeries[]
  breakoutGroups BreakoutGroup[]
  committees     VolunteerCommittee[]
  volunteers     Volunteer[]
  modules        EventModule[]
  baptismOptIns  BaptismOptIn[]
  buses             Bus[]
  userAccess        UserEventAccess[]
  confirmationSubmissions ConfirmationSubmission[]
  catchMechSessions CatchMechSession[]
  catchMechVolunteerSessions CatchMechVolunteerSession[]
  memberLogs        MemberLog[]
  formConfigs       FormConfig[]
  eventFormConfigs  EventFormConfig[]
  dashboardWidgets  EventDashboardWidget[]
  clusterMembership EventClusterEvent?
  // DGroup requests raised by someone ticking "I want to join a DGroup" on this
  // event's registration form (CCF-101).
  smallGroupRequests SmallGroupMemberRequest[] @relation("SmallGroupRequestSource")

  @@index([walkInOccurrenceId])
}

model EventMinistry {
  eventId    String
  ministryId String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([eventId, ministryId])
}

// Event Cluster ("Event Day") — a named grouping of events that share one public
// registration form and one aggregated admin workspace. Member events stay fully
// independent underneath; the cluster is an aggregation layer on top.
model EventCluster {
  id          String    @id @default(cuid())
  name        String
  description String?
  date        DateTime?
  // What shape of day this is (CCF-148). Defaults to `Parallel`, so every
  // cluster created before this column behaves exactly as it did.
  kind        ClusterKind @default(Parallel)
  publicToken String    @unique @default(cuid())
  // Manual open/close for the shared public form (mirrors FormConfig.isOpen)
  isOpen      Boolean   @default(false)
  // The same, for the day's door form (CCF-133). Separate from `isOpen` so the
  // shared form can close the night before while the door still runs, and vice
  // versa. Clusters can't use FormConfig for this — that table is keyed by
  // eventId only.
  walkInIsOpen Boolean  @default(false)
  // And again, for the day's check-in kiosk. A third switch rather than a reuse
  // of the two above: the door creates registrations, the kiosk only records
  // attendance for people already registered, and a day routinely wants one
  // running without the other.
  checkInIsOpen Boolean @default(false)
  // And the day's volunteer sign-up form. Serving teams are recruited on their
  // own timetable — weeks before the attendee form opens, and closed once the
  // roster is full — so it gets its own switch like the other three.
  volunteerIsOpen Boolean @default(false)
  registrationStart DateTime?
  registrationEnd   DateTime?
  // Registration page customization — mirrors Event's public form fields
  logoUrl                     String?
  themeColorPrimary           String?
  registrationPageTitle       String?
  registrationPageDescription String?
  registrationPageBannerUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events         EventClusterEvent[]
  formConfigs    EventFormConfig[]
  registrants    EventRegistrant[]
  // A Collab cluster's own breakout tables — the day's groups, as opposed to
  // either member event's standing ones. See `BreakoutGroup`'s owner comment.
  breakoutGroups BreakoutGroup[]
  // Volunteers who signed up to serve on this day. Named rather than implicit
  // because the rows belong to their events; this is provenance, not ownership.
  volunteerSignUps Volunteer[] @relation("ClusterVolunteerSignUps")
}

model EventClusterEvent {
  clusterId String
  eventId   String
  order     Int          @default(0)
  cluster   EventCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Which session of a Recurring event this cluster day stands for. Null on
  // OneTime links and on links made before session selection existed — null
  // keeps the date-window behavior, so legacy clusters are untouched. SetNull:
  // deleting a session degrades the link back to date-window, never breaks it.
  occurrenceId String?
  occurrence   EventOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@id([clusterId, eventId])
  @@unique([eventId]) // one cluster per event
  @@index([occurrenceId])
}

model EventOccurrenceSeries {
  id         String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  occurrences EventOccurrence[]

  @@index([eventId, startDate, endDate])
}

model EventOccurrence {
  id        String               @id @default(cuid())
  eventId   String
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    EventOccurrenceSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  date      DateTime
  notes     String?
  isOpen    Boolean              @default(false)
  isStandalone Boolean           @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  attendees        OccurrenceAttendee[]
  subFacilitators  OccurrenceSubFacilitator[]
  clusterLinks     EventClusterEvent[]
  // Back-reference for Event.walkInOccurrenceId. A list only because Prisma
  // requires one; at most one event points here, since it is that event's own
  // session.
  walkInForEvents  Event[]                    @relation("EventWalkInSession")

  @@unique([eventId, date])
  @@index([seriesId])
}

model OccurrenceAttendee {
  id           String          @id @default(cuid())
  occurrenceId String
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  // Exactly one of registrantId / volunteerId is set (app-layer enforced), mirroring the
  // EventRegistrant memberId/guestId convention. A volunteer is never a registrant.
  registrantId String?
  registrant   EventRegistrant? @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  volunteerId  String?
  volunteer    Volunteer?       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  checkedInAt  DateTime        @default(now())
  // Admin override for the derived New/Returning badge. The status is normally
  // derived from prior attendance (lib/session-stats.ts), but a guest who
  // attended before the church started recording sessions looks "New" forever —
  // so an admin can pin it. null = use the derived value.
  isReturnerOverride Boolean?

  @@unique([occurrenceId, registrantId])
  @@unique([occurrenceId, volunteerId])
}

enum FacilitatorRole {
  Facilitator
  CoFacilitator
}

model OccurrenceSubFacilitator {
  id              String          @id @default(cuid())
  occurrenceId    String
  occurrence      EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  breakoutGroupId String
  breakoutGroup   BreakoutGroup   @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  role            FacilitatorRole
  substituteId    String
  substitute      Volunteer       @relation(fields: [substituteId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([occurrenceId, breakoutGroupId, role])
}

model EventRegistrant {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Cascade, not the Prisma default. An optional relation defaults to SetNull,
  // which orphaned this row on member deletion: both FKs null and the personal
  // columns below never populated (they're only written when the registrant had
  // no FK to begin with), leaving a nameless registrant no query can resolve.
  // Cascade also makes the two person FKs symmetric — a promoted guest moves its
  // registrations from guestId to memberId, so anything else means deleting the
  // same human has different consequences depending on when you do it.
  memberId     String?
  member       Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  guestId      String?
  guest        Guest?    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  // Only populated when both memberId and guestId are null (truly anonymous registrant)
  firstName    String?
  lastName     String?
  nickname     String?
  email        String?
  mobileNumber String?

  // Provenance: set when this registration came in through a cluster's shared
  // form (analytics only — the registrant is still fully owned by its event).
  registrationClusterId String?
  registrationCluster   EventCluster? @relation(fields: [registrationClusterId], references: [id], onDelete: SetNull)

  isPaid           Boolean   @default(false)
  paymentReference String?
  // Dietary restrictions — populated when the event's registration form has the Dietary module enabled
  dietaryPreference DietaryPreference?
  dietaryOther      String?
  attendedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  breakoutGroupMemberships BreakoutGroupMember[]
  baptismOptIn             BaptismOptIn?
  busPassengers            BusPassenger[]
  occurrenceAttendances    OccurrenceAttendee[]
}

model BreakoutGroup {
  id            String       @id @default(cuid())
  // Exactly one of eventId / clusterId is set (app-layer enforced XOR, the same
  // shape `EventFormConfig` uses — see `isValidBreakoutOwner`).
  //
  // An event-owned group is a standing table: it belongs to one event and
  // persists across that event's occurrences. A cluster-owned group belongs to a
  // Collab day (CCF-148) and is set up for that session — which is why a collab
  // gets a fresh set rather than inheriting either ministry's standing tables,
  // and why seating people on the day can never rewrite those tables.
  //
  // Cluster-owned groups seat registrants of ANY of the cluster's member events,
  // which the schema already permitted: `BreakoutGroupMember` never constrained
  // the registrant's event to the group's.
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       EventCluster? @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  name          String
  facilitatorId   String?
  facilitator     Volunteer?   @relation("FacilitatedGroups", fields: [facilitatorId], references: [id])
  coFacilitatorId String?
  coFacilitator   Volunteer?   @relation("CoFacilitatedGroups", fields: [coFacilitatorId], references: [id])

  // Matching fields (mirrors SmallGroup)
  lifeStages    LifeStage[]  @relation("BreakoutGroupLifeStages")
  genderFocus   GenderFocus?
  language      String[]
  ageRangeMin   Int?
  ageRangeMax   Int?
  meetingFormat MeetingFormat?
  locationCity  String?
  memberLimit   Int?

  // Off takes the group out of every automatic and public intake path — the
  // registration picker, the walk-in picker, auto-assign, match suggestions.
  // Admin screens can still place people in deliberately, and the group keeps
  // its roster, its facilitator and its linked DGroup.
  isEnabled     Boolean      @default(true)

  // Never *suggested*, never auto-assigned — but still fully pickable.
  //
  // The narrow sibling of `isEnabled`. Off-switching a group closes every
  // automatic AND public route into it; this closes only the automatic ones, so
  // the table keeps its place in the registration form's dropdown, the kiosk's
  // browse list and the admin add/transfer screens. For a table an admin fills
  // by hand but doesn't want the matcher pushing arrivals into.
  //
  // Deliberately NOT part of `ENABLED_BREAKOUT_WHERE` or any candidate query:
  // the picker and the suggester share one loaded set, so this has to reach
  // `BreakoutCandidate` and be applied in `isEligible` alone.
  manualAssignOnly Boolean   @default(false)

  // Linked small group for temp-membership assignment on registrant assignment
  linkedSmallGroupId String?
  linkedSmallGroup   SmallGroup? @relation("BreakoutLinkedGroup", fields: [linkedSmallGroupId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members           BreakoutGroupMember[]
  schedules         BreakoutGroupSchedule[]
  catchMechSessions CatchMechSession[]
  subFacilitators   OccurrenceSubFacilitator[]
  confirmationSubmissions ConfirmationSubmission[]

  @@index([eventId])
  @@index([clusterId])
}

model BreakoutGroupSchedule {
  id              String        @id @default(cuid())
  breakoutGroupId String
  breakoutGroup   BreakoutGroup @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  dayOfWeek       Int           // 0 = Sunday, 6 = Saturday
  timeStart       String?       // HH:MM — optional, day-only schedules are valid
  timeEnd         String?       // HH:MM
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BreakoutGroupMember {
  breakoutGroupId String
  breakoutGroup   BreakoutGroup   @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  registrantId    String
  registrant      EventRegistrant @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  assignedAt      DateTime        @default(now())

  @@id([breakoutGroupId, registrantId])
}

model VolunteerCommittee {
  id        String   @id @default(cuid())
  name      String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles      CommitteeRole[]
  volunteers Volunteer[]
}

model CommitteeRole {
  id          String             @id @default(cuid())
  name        String
  committeeId String
  committee   VolunteerCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  preferredByVolunteers Volunteer[] @relation("PreferredRole")
  assignedToVolunteers  Volunteer[] @relation("AssignedRole")
}

model Volunteer {
  id              String             @id @default(cuid())
  memberId        String
  member          Member             @relation(fields: [memberId], references: [id])
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id])
  committeeId     String
  committee       VolunteerCommittee @relation(fields: [committeeId], references: [id])
  preferredRoleId String
  preferredRole   CommitteeRole      @relation("PreferredRole", fields: [preferredRoleId], references: [id])
  assignedRoleId  String?
  assignedRole    CommitteeRole?     @relation("AssignedRole", fields: [assignedRoleId], references: [id])
  status               VolunteerStatus    @default(Pending)
  // Provenance: set when this sign-up came in through an event day's shared
  // volunteer form. The row stays owned by its event — a person volunteers under
  // a ministry — but a Collab day tracks its own serving team, and this column is
  // what makes "who signed up to serve on the day" answerable at all. Without it
  // the day could only show the union of both ministries' standing rosters, which
  // is everyone who ever volunteered rather than anyone who volunteered for this.
  signUpClusterId      String?
  signUpCluster        EventCluster?     @relation("ClusterVolunteerSignUps", fields: [signUpClusterId], references: [id], onDelete: SetNull)
  notes                String?
  leaderApprovalToken  String?           @unique
  leaderNotes          String?
  // OneTime-event attendance marker, symmetric to EventRegistrant.attendedAt.
  // Session-based (MultiDay/Recurring) attendance lives in OccurrenceAttendee.
  attendedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  facilitatedGroups     BreakoutGroup[] @relation("FacilitatedGroups")
  coFacilitatedGroups   BreakoutGroup[] @relation("CoFacilitatedGroups")
  busPassengers         BusPassenger[]
  catchMechSessions     CatchMechSession[]
  catchMechVolunteerSessions CatchMechVolunteerSession[]
  declinedRequests      SmallGroupMemberRequest[] @relation("DeclinedRequests")
  subFacilitatorSlots   OccurrenceSubFacilitator[]
  occurrenceAttendances OccurrenceAttendee[]
  confirmationSubmissions ConfirmationSubmission[] @relation("ConfirmationSubmissionFacilitator")

  @@index([signUpClusterId])
}

model MatchingWeightConfig {
  id        String          @id @default(cuid())
  context   MatchingContext @unique
  lifeStage Float
  gender    Float
  language  Float
  age       Float
  schedule  Float
  location  Float
  mode      Float
  career    Float
  capacity  Float
  // Days a group is excluded from guest match suggestions after receiving a
  // guest assignment (0 = disabled). Only meaningful on the SmallGroup row.
  guestCooldownDays Int      @default(7)
  updatedAt DateTime        @updatedAt
}

// ─── Event Add-on Modules ─────────────────────────────────────────────────────

model EventModule {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      EventModuleType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([eventId, type])
}

model BaptismOptIn {
  id           String          @id @default(cuid())
  eventId      String
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrantId String          @unique  // one baptism per registrant globally (across all events)
  registrant   EventRegistrant @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@unique([eventId, registrantId])
}

model Bus {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?         // null = unlimited
  direction BusDirection @default(ToVenue)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  passengers BusPassenger[]
}

model BusPassenger {
  id           String           @id @default(cuid())
  busId        String
  bus          Bus              @relation(fields: [busId], references: [id], onDelete: Cascade)
  registrantId String?
  registrant   EventRegistrant? @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  volunteerId  String?
  volunteer    Volunteer?       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  // Exactly one of registrantId or volunteerId must be set (enforced at app layer)
}

// ─── Small Group Member Requests & Logs ──────────────────────────────────────

model SmallGroupMemberRequest {
  id           String              @id @default(cuid())
  // Null only for a groupless decline: a Timothy who leads no group yet declines
  // someone, so there is no group to scope the rejection to. Every other request
  // (Pending, Confirmed, and any decline by a faci who leads a group) sets this.
  smallGroupId String?
  smallGroup   SmallGroup?         @relation(fields: [smallGroupId], references: [id], onDelete: Cascade)

  // Exactly one of guestId or memberId must be set (enforced at app layer)
  guestId      String?
  guest        Guest?              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // For member transfers: record the source group at request time
  fromGroupId  String?
  fromGroup    SmallGroup?         @relation("TransferFrom", fields: [fromGroupId], references: [id])

  status       MemberRequestStatus @default(Pending)
  // Structured rejection reason (analytics-friendly); notes holds free text for Others
  declineReason DeclineReason?
  notes        String?

  assignedByUserId String?
  assignedByUser   User?           @relation(fields: [assignedByUserId], references: [id])

  // Tracks which breakout group triggered this request (for auto-cancellation on removal)
  breakoutGroupId  String?

  // Where this request came from (CCF-101). `Assignment` is every pre-existing
  // path — an admin, a facilitator, or the public join page picking a specific
  // group. `RegistrationIntent` is someone ticking "I want to join a DGroup" on an
  // event form: real demand with no group chosen yet, so it is the one origin that
  // legitimately carries a null smallGroupId while still Pending.
  origin        SmallGroupRequestOrigin @default(Assignment)

  // The event whose registration form produced a RegistrationIntent request, so
  // the admin triaging it can see where the person came from. Null for every other
  // origin.
  sourceEventId String?
  sourceEvent   Event?  @relation("SmallGroupRequestSource", fields: [sourceEventId], references: [id], onDelete: SetNull)

  // The faci who declined via Catch Mech. Only needed to scope a groupless decline
  // (smallGroupId = null) to its author — lead and co-faci share a breakout group,
  // so breakoutGroupId alone cannot tell their lists apart.
  declinedByVolunteerId String?
  declinedByVolunteer   Volunteer? @relation("DeclinedRequests", fields: [declinedByVolunteerId], references: [id], onDelete: SetNull)

  comments     CatchMechComment[]

  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([sourceEventId])
  @@index([origin, status])
}

model SmallGroupLog {
  id           String              @id @default(cuid())
  smallGroupId String
  smallGroup   SmallGroup          @relation(fields: [smallGroupId], references: [id], onDelete: Cascade)
  action       SmallGroupLogAction

  // Subject (who was affected)
  memberId     String?
  member       Member?             @relation("SmallGroupLogSubject", fields: [memberId], references: [id])
  guestId      String?
  guest        Guest?              @relation(fields: [guestId], references: [id])

  // Transfer metadata
  fromGroupId  String?
  toGroupId    String?

  // Actor — an admin User for dashboard writes, or a Member for the public
  // token flows (Catch Mech facilitators and small group leaders never log in).
  performedByUserId String?
  performedByUser   User?          @relation(fields: [performedByUserId], references: [id])
  performedByMemberId String?
  performedByMember   Member?      @relation("SmallGroupLogActor", fields: [performedByMemberId], references: [id], onDelete: SetNull)

  description  String?
  createdAt    DateTime            @default(now())
}

model MemberLog {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action      String
  description String?
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// ─── Catch Mech ──────────────────────────────────────────────────────────────

model CatchMechSession {
  id                     String        @id @default(cuid())
  token                  String        @unique @default(cuid())
  eventId                String
  event                  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  breakoutGroupId        String
  breakoutGroup          BreakoutGroup @relation(fields: [breakoutGroupId], references: [id], onDelete: Cascade)
  facilitatorVolunteerId String
  facilitator            Volunteer     @relation(fields: [facilitatorVolunteerId], references: [id], onDelete: Cascade)
  createdAt              DateTime      @default(now())

  submissions            ConfirmationSubmission[]
}

model CatchMechVolunteerSession {
  id           String   @id @default(cuid())
  token        String   @unique @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteerId  String
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  submissions ConfirmationSubmission[]

  @@unique([eventId, volunteerId])
  @@index([eventId, createdAt])
}

model CatchMechComment {
  id        String                  @id @default(cuid())
  requestId String
  request   SmallGroupMemberRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime                @default(now())
}

// ─── Confirmation submissions ────────────────────────────────────────────────
// One row per time a facilitator (Catch Mech) or a small group leader answers
// their confirmation form. Written unconditionally — a submission that changes
// nothing (everything deferred, a Timothy declining with no group yet, a repeat
// submission) is exactly the case the per-person SmallGroupLog cannot record.
model ConfirmationSubmission {
  id     String                       @id @default(cuid())
  source ConfirmationSubmissionSource

  // Catch Mech context (null for leader submissions)
  sessionId              String?
  session                CatchMechSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  volunteerSessionId     String?
  volunteerSession       CatchMechVolunteerSession? @relation(fields: [volunteerSessionId], references: [id], onDelete: SetNull)
  eventId                String?
  event                  Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  breakoutGroupId        String?
  breakoutGroup          BreakoutGroup?    @relation(fields: [breakoutGroupId], references: [id], onDelete: SetNull)
  facilitatorVolunteerId String?
  facilitator            Volunteer?        @relation("ConfirmationSubmissionFacilitator", fields: [facilitatorVolunteerId], references: [id], onDelete: SetNull)

  // Leader context (null for Catch Mech submissions)
  smallGroupId String?
  smallGroup   SmallGroup? @relation("ConfirmationSubmissionGroup", fields: [smallGroupId], references: [id], onDelete: SetNull)

  // Submitter — a Member in both flows (the faci's member, or the group's leader).
  // The name is denormalized so the audit row stays readable after a delete.
  submittedByMemberId String?
  submittedByMember   Member? @relation("ConfirmationSubmissionSubmitter", fields: [submittedByMemberId], references: [id], onDelete: SetNull)
  submittedByName     String

  confirmedCount Int @default(0)
  declinedCount  Int @default(0)
  deferredCount  Int @default(0)

  createdGroupId String? // set when the Timothy path created a new SmallGroup
  decisions      Json    // raw decisions payload, for dispute resolution

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([breakoutGroupId])
  @@index([facilitatorVolunteerId])
  @@index([volunteerSessionId])
  @@index([smallGroupId])
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSettings {
  id                          String   @id @default("singleton")
  joinPageTitle               String   @default("Find Your Small Group")
  joinPageDescription         String   @default("Tell us about yourself and we'll suggest the best small groups for you.")
  joinPageLogoUrl             String   @default("")
  joinPageBackgroundImageUrl  String   @default("")
  joinPageAccentColor         String   @default("")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ─── Form Config ──────────────────────────────────────────────────────────────
// Per-form public-access (open/closed) + theme overrides. One row per form:
// global forms key on "global:<FormKey>"; event forms on "<eventId>:<FormKey>".
model FormConfig {
  id           String   @id @default(cuid())
  scopeKey     String   @unique
  key          FormKey
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isOpen       Boolean  @default(true)
  // per-form theme overrides (all optional → fall back to scope defaults)
  title        String?
  description  String?
  logoUrl      String?
  bannerUrl    String?
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
}

// ─── Event Form Config (per context) ─────────────────────────────────────────
// Which sections and fields the Register / Walk-in / Check-in surfaces collect,
// configured independently per context. Replaces the flat Event.formInclude*
// booleans, which applied to every context at once.
//
// A missing row means "bare" — only the mandatory identity fields. New events
// start bare by design; existing events were backfilled from their old flat
// toggles so their live behavior carried over unchanged.
model EventFormConfig {
  id      String      @id @default(cuid())
  // Exactly one of eventId / clusterId is set (app-layer enforced XOR) — a config
  // belongs to either a single event or an event cluster's shared form.
  eventId String?
  event   Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clusterId String?
  cluster   EventCluster? @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  context FormContext

  // Section toggles — whole steps in the flow
  sectionSmallGroup Boolean @default(false)
  sectionBreakout   Boolean @default(false)
  sectionDietary    Boolean @default(false)
  sectionPayment    Boolean @default(false)
  sectionFamily     Boolean @default(false)

  // Section options — modifiers on a section rather than sections themselves.
  // Spouse-only narrows Family mode to just the spouse sub-form, which is the
  // "Spouse-only" capture tier (the three tiers are: sectionFamily off /
  // sectionFamily + familySpouseOnly / sectionFamily alone = full household).
  familySpouseOnly  Boolean @default(false)

  // Field toggles — inputs inside Personal Information. Name is the only thing
  // always collected; everything else, mobile and email included, is a toggle.
  //
  // Mobile and email default to ON (CCF-142) because they were hardcoded
  // always-on before they became configurable, so an existing row — and a
  // missing row, via FORM_TOGGLE_DEFAULTS — keeps collecting both. At least one
  // of the two must stay on: mobile is the app's person key (member resolution
  // and walk-in/check-in lookup are exact mobile matches) and email is the only
  // fallback. Enforced in `saveEventFormConfig`, not by a DB constraint, since
  // the pair spans two columns on a row the builder writes one toggle at a time.
  fieldNickname          Boolean @default(false)
  fieldMobile            Boolean @default(true)
  fieldEmail             Boolean @default(true)
  fieldLifeStage         Boolean @default(false)
  fieldGender            Boolean @default(false)
  fieldBirthDate         Boolean @default(false)
  fieldAgeRange          Boolean @default(false)
  fieldWorkCity          Boolean @default(false)
  fieldLanguage          Boolean @default(false)
  fieldSchedule          Boolean @default(false)
  fieldMeetingPreference Boolean @default(false)

  // Per-field Required flags (CCF-142). One `<fieldKey>Required` column per field
  // toggle above, so the config stays a flat Record<key, boolean> — the shape
  // every read, copy and validation helper already iterates.
  //
  // Required is only meaningful for an enabled field: a flag left set on a field
  // that is later switched off is ignored on read rather than cleared on write,
  // so switching the field back on restores what the admin had configured.
  fieldNicknameRequired          Boolean @default(false)
  fieldMobileRequired            Boolean @default(false)
  fieldEmailRequired             Boolean @default(false)
  fieldLifeStageRequired         Boolean @default(false)
  fieldGenderRequired            Boolean @default(false)
  fieldBirthDateRequired         Boolean @default(false)
  fieldAgeRangeRequired          Boolean @default(false)
  fieldWorkCityRequired          Boolean @default(false)
  fieldLanguageRequired          Boolean @default(false)
  fieldScheduleRequired          Boolean @default(false)
  fieldMeetingPreferenceRequired Boolean @default(false)

  // Per-section Required flags. Only two sections can carry one, and the line is
  // whether the section owns a single stored answer that is either given or
  // blank: Dietary has `dietaryPreference`, Payment has `paymentReference`.
  // Breakout can be satisfied by auto-assign, an empty household is a legitimate
  // answer, and the DGroup step already makes you answer its intent — requiring
  // any of those would enforce something the form can meet by accident.
  sectionDietaryRequired Boolean @default(false)
  sectionPaymentRequired Boolean @default(false)

  // Copy shown under "Welcome, <name>!" on the success screen (CCF-130). Null
  // falls back to the built-in default — the stock copy invites people to bring a
  // friend, which is wrong for an invite-only event, so it has to be overridable
  // per event and per context.
  successMessage String?

  // When an admin last saved this config from the builder. Null means no admin
  // has ever been here — the row exists only because a migration wrote it.
  //
  // This is the setup checklist's "has the form been configured?" signal, and it
  // exists because the two cheaper signals are both wrong. Row existence became
  // meaningless when `20260804000000_add_form_field_nickname` backfilled a row
  // for every event that had none. Reading the toggles instead made the step
  // un-tick when an admin switched the last one back off, which is not what
  // "configured" means — they have been through the builder and made a choice,
  // and the choice being "ask for nothing extra" is still a choice.
  //
  // Only ever set by the write paths in form-config-actions.ts, never by a
  // migration backfill, which is exactly what makes it trustworthy.
  configuredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, context])
  @@unique([clusterId, context])
  @@index([eventId])
  @@index([clusterId])
}

/// Per-event dashboard layout: which widgets show, in what order, at what width.
///
/// No rows for an event means "never customized" — the dashboard falls back to
/// the code-defined defaults in `lib/events/dashboard-widgets.ts`, which is also
/// the state the Reset button restores by deleting every row.
///
/// `key` is a plain String rather than an enum so adding a widget never needs a
/// migration; it is validated against `DASHBOARD_WIDGET_KEYS` on write and
/// ignored by the resolver on read, so a key retired later just stops resolving.
/// `width` is a 12-column grid span (4, 6, 8 or 12) and is unused by KPI tiles.
model EventDashboardWidget {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key     String
  visible Boolean @default(true)
  order   Int
  width   Int     @default(12)

  // No updatedAt: a save rewrites every row for the event wholesale, so a
  // per-row modification time would never say anything the event's own doesn't.
  createdAt DateTime @default(now())

  @@unique([eventId, key])
  @@index([eventId])
}
